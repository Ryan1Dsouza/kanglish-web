{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python scripts/build_web.py",
  "outputDirectory": "public",
  "regions": ["bom1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 90,
      "includeFiles": "{scripts/**,mobile/android/app/src/main/assets/**,data/corpus/**}"
    }
  },
  "rewrites": [{"source": "/api/:path*", "destination": "/api/index?__route=:path*"}],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; media-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"},
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "X-Frame-Options", "value": "DENY"},
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()"}
    ]
  }]
}
